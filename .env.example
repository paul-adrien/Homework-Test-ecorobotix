# --- Database (PostgreSQL, running in Docker via docker-compose) ---
DATABASE_URL="postgresql://agriwatch:agriwatch@localhost:5432/agriwatch?schema=public"

# --- Session ---
# Used to sign session cookies. Replace with a long random string in production.
SESSION_SECRET="change-me-please-use-at-least-32-characters-for-production"

# --- API ---
API_PORT=3000
NODE_ENV="development"

# --- Optional weather providers (Phase 2) ---
# Leave blank to hide these providers from the UI switcher.
# How to obtain keys: see README "Optional providers".
OPENWEATHERMAP_API_KEY=""
WEATHERAPI_KEY=""
